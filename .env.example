# Copier ce fichier en .env (jamais commité) puis renseigner les valeurs vides.

# Postgres (conteneur db)
POSTGRES_USER=simatis
# Mot de passe hexadécimal, sans caractère spécial : openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=simatis

# Rôle restreint avec lequel l'app tourne (soumis au cloisonnement par instance).
# Autre mot de passe hexadécimal : openssl rand -hex 24
APP_DB_PASSWORD=

# Sauvegarde chiffrée (restic). Sans ce mot de passe, les sauvegardes sont illisibles :
# le ranger dans un gestionnaire de mots de passe. openssl rand -hex 24
RESTIC_PASSWORD=
# Destination : vide = dépôt local de test (même machine, ne protège pas d'une panne du poste).
# Hors site, compatible S3 en UE ou en Suisse, par exemple :
#   RESTIC_REPOSITORY=s3:https://s3.pub1.infomaniak.cloud/simatis-sauvegardes
RESTIC_REPOSITORY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Écritures réelles vers les outils tiers (HubSpot, Gmail…) : off par défaut, on pour les activer
REAL_WRITES=off

# Ports exposés sur 127.0.0.1 uniquement (à changer s'ils sont déjà pris)
APP_PORT=4300
DB_PORT=5440

# Uniquement pour lancer l'app hors Docker (npm run dev) : même mot de passe que ci-dessus
DATABASE_URL=postgres://simatis:<mot-de-passe>@127.0.0.1:5440/simatis

# fatal, error, warn, info, debug ou trace
LOG_LEVEL=info
